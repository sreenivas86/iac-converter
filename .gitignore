# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Terraform working data and state
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan

# Terraform variable files may contain secrets. Keep examples trackable.
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json

# Local environment and editor files
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
*.swo
*~

# OS metadata
.DS_Store
Thumbs.db
